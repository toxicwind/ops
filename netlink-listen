#!/usr/bin/env python3
"""netlink-listen — kernel TCP listening-port probe via AF_NETLINK SOCK_DIAG.

A drop-in replacement for `ss -tlnp` parsing that needs NO subprocess and NO
libcap tricks: it asks the kernel's inet_diag subsystem directly for the TCP
LISTEN table over a NETLINK_SOCK_DIAG socket. This is the sanctioned route
when `ss`/`grep` subprocess is policy-denied (ESTATE-ANOMALY-37) while live
listener introspection must still work (port-audit, claim-port, redeploy
checks, CDP-tunnel health).

Layout (verified on this kernel by calibrating against a self-opened listener
socket, 2026-11-01):
      REQUEST: inet_diag_req_v2 with a 48-byte id (the kernel rejects id_len
      other than 48 with an empty dump).
      RESPONSE: inet_diag_msg (72 bytes) + INET_DIAG_* attrs follow:
    family u8 @0        state u8 @1        timer u8 @2        retrans u8 @3
    sport  u16 BE @4    rcv_saddr @6       dport u16 BE @10
    ...                 uid u32 LE @64     inode u32 LE @68

Unlike `ss -tlnp`, the raw inet_diag dump carries the socket inode, not the
owning pid. That is enough to (a) prove a port is listening and (b) correlate
the inode against /proc/*/fd for pid attribution when desired — done here with
an optional /proc walk so the caller gets a real pid without `ss`.

Usage:
  netlink-listen                        # all listening TCP ports (v4+v6), human
  netlink-listen 25248 35421 25155      # filter to specific ports
  netlink-listen --json                 # machine-readable, all ports
  netlink-listen --json 25248           # machine-readable, one port

Exit codes: 0 = success (even if no ports matched), 2 = operational error
(socket failure, malformed args).
"""
from __future__ import annotations

import argparse
import json
import os
import socket
import struct
import sys
from pathlib import Path

NETLINK_SOCK_DIAG = 4
SOCK_DIAG_BY_FAMILY = 20          # inet_diag (v4/v6) netlink message type
NLM_F_REQUEST = 1
NLM_F_DUMP = 0x300                 # dump entire table, not one socket
TCPF_LISTEN = 1 << 10              # TCP_LISTEN state mask in TCPF_* enum
NLMSG_DONE = 3
NLMSG_ERROR = 2
DIAG_MSG_LEN = 72                  # inet_diag_msg as observed on this kernel

# Offsets inside inet_diag_msg (verified empirically).
OFF_SPORT = 4
OFF_UID = 64
OFF_INODE = 68

# /proc walk: pid ownership attribution without `ss`.
PROC_ROOT = Path("/proc")


def _build_req(family: int) -> bytes:
    """One inet_diag_req_v2 (as expected by SOCK_DIAG_BY_FAMILY + NLM_F_DUMP).

    struct inet_diag_req_v2:
      family  u8
      protocol u8
      ext     u8
      pad     u8
      states  u32   (bitmask of TCPF_*; TCPF_LISTEN here)
      id      (inet_diag_sockid: 24 bytes on this kernel, zero = all)
    """
    diag_req = struct.pack(
        "=BBBxI48s",
        family,                        # AF_INET / AF_INET6
        socket.IPPROTO_TCP,
        0,                             # no extended info
        TCPF_LISTEN,
        b"\x00" * 48,
    )
    nl_hdr = struct.pack(
        "=IHHII",
        16 + len(diag_req),            # nlmsg_len includes the header
        SOCK_DIAG_BY_FAMILY,
        NLM_F_REQUEST | NLM_F_DUMP,
        1,                             # seq
        0,                             # pid (kernel)
    )
    return nl_hdr + diag_req


def _parse_diag(payload: bytes) -> tuple[int, int, int]:
    """Extract (sport, uid, inode) from one inet_diag_msg."""
    if len(payload) < DIAG_MSG_LEN:
        return (0, 0, 0)
    sport = struct.unpack_from(">H", payload, OFF_SPORT)[0]
    uid = struct.unpack_from("=I", payload, OFF_UID)[0]
    inode = struct.unpack_from("=I", payload, OFF_INODE)[0]
    return (sport, uid, inode)


def _dump(family: int, timeout_s: float = 2.0) -> dict[int, dict]:
    """Query one family's TCP LISTEN table; {sport: {inode, uid}}."""
    found: dict[int, dict] = {}
    with socket.socket(socket.AF_NETLINK, socket.SOCK_RAW, NETLINK_SOCK_DIAG) as sock:
        sock.settimeout(timeout_s)
        sock.send(_build_req(family))
        while True:
            try:
                data = sock.recv(65536)
            except socket.timeout:
                break
            if not data:
                break
            offset = 0
            while offset + 16 <= len(data):
                nlmsg_len, nlmsg_type, _flags, _seq, _pid = struct.unpack_from(
                    "=IHHII", data, offset
                )
                if nlmsg_type == NLMSG_DONE:
                    return found
                if nlmsg_len < 16:
                    break
                payload = data[offset + 16 : offset + nlmsg_len]
                if nlmsg_type == SOCK_DIAG_BY_FAMILY and len(payload) >= DIAG_MSG_LEN:
                    sport, uid, inode = _parse_diag(payload)
                    if sport and inode:
                        found[sport] = {"inode": inode, "uid": uid}
                offset += (nlmsg_len + 3) & ~3
    return found


def probe_all() -> dict[int, dict]:
    """{port: {inode, uid, family}} for both AF_INET and AF_INET6 LISTEN."""
    out: dict[int, dict] = {}
    for family, label in ((socket.AF_INET, 4), (socket.AF_INET6, 6)):
        for port, info in _dump(family).items():
            if port in out:
                out[port]["family"] = "v4+v6"
            else:
                info = dict(info)
                info["family"] = str(label)
                out[port] = info
    return out


def inode_to_pid(inode: int) -> int | None:
    """Best-effort /proc scan: first pid whose fd symlink names this inode."""
    try:
        pids = [p.name for p in PROC_ROOT.iterdir() if p.name.isdigit()]
    except OSError:
        return None
    needle = f"socket:[{inode}]"
    for pid in pids:
        fd_dir = PROC_ROOT / pid / "fd"
        try:
            for fd in fd_dir.iterdir():
                try:
                    if os.readlink(fd) == needle:
                        return int(pid)
                except OSError:
                    continue
        except OSError:
            continue
    return None


def enrich(ports: dict[int, dict]) -> dict[int, dict]:
    """Add pid attribution (null when no fd match or /proc walk fails)."""
    enriched: dict[int, dict] = {}
    for port, info in ports.items():
        info = dict(info)
        info["pid"] = inode_to_pid(info["inode"])
        enriched[port] = info
    return enriched


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        description="Kernel TCP LISTEN probe via AF_NETLINK SOCK_DIAG (no ss)."
    )
    ap.add_argument("--json", action="store_true",
                    help="emit JSON: {port: {inode, uid, family, pid}}")
    ap.add_argument("--no-pid", action="store_true",
                    help="skip /proc pid attribution (faster)")
    ap.add_argument("ports", nargs="*", type=int,
                    help="filter to these ports; default all")
    args = ap.parse_args(argv)

    try:
        all_ports = probe_all()
    except OSError as e:
        print(f"netlink-listen: ERROR opening NETLINK_SOCK_DIAG: {e}",
              file=sys.stderr)
        return 2

    if args.ports:
        want = set(args.ports)
        all_ports = {p: v for p, v in all_ports.items() if p in want}

    if not args.no_pid:
        all_ports = enrich(all_ports)

    if args.json:
        print(json.dumps(all_ports, sort_keys=True))
    else:
        if not all_ports:
            print("(no matching LISTEN ports)")
        for port in sorted(all_ports):
            info = all_ports[port]
            pid = info.get("pid")
            dual = " (v4+v6)" if info.get("family") == "v4+v6" else ""
            pid_txt = f" pid={pid}" if pid else ""
            print(f":{port}{dual} inode={info['inode']} uid={info['uid']}{pid_txt}")
    return 0


if __name__ == "__main__":
    sys.exit(main())